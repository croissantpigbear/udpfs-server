#!/bin/bash
# Starts the UDPFS Server window with the Python inside this app.
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
GUI="$RES/app/udpfs_gui.pyw"

# Apple silicon runs the arm64 Python, even when this script itself was
# started under Rosetta.
if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ]; then
  order=(aarch64 x86_64)
else
  order=(x86_64)
fi
for arch in "${order[@]}"; do
  PY="$RES/python-$arch/bin/python3"
  if [ -x "$PY" ]; then
    if [ "$arch" = x86_64 ] && [ "${order[0]}" = aarch64 ]; then
      exec arch -x86_64 "$PY" "$GUI" "$@"
    fi
    exec "$PY" "$GUI" "$@"
  fi
done

/usr/bin/osascript -e 'display alert "UDPFS Server is damaged" message "Download it again and copy the whole app." as critical'
exit 1
