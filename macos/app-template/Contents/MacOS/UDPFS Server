#!/bin/bash
# Starts the UDPFS Server window with the first Python 3 that has tkinter.
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
GUI="$RES/udpfs-server/udpfs_gui.pyw"

candidates=(
  /Library/Frameworks/Python.framework/Versions/Current/bin/python3
  /Library/Frameworks/Python.framework/Versions/3.*/bin/python3
  /opt/homebrew/bin/python3
  /usr/local/bin/python3
)
# Apple's own python3 only exists once the Command Line Tools are installed;
# asking it otherwise pops up the installer.
if xcode-select -p >/dev/null 2>&1; then candidates+=(/usr/bin/python3); fi

for PY in "${candidates[@]}"; do
  if [ -x "$PY" ] && "$PY" -c "import tkinter" >/dev/null 2>&1; then
    exec "$PY" "$GUI" "$@"
  fi
done

/usr/bin/osascript <<'OSA'
set r to display alert "UDPFS Server needs Python 3" message "Install Python 3 from python.org (it includes the window toolkit), then open UDPFS Server again.

With Homebrew instead: brew install python-tk" as critical buttons {"Cancel", "Open python.org"} default button 2
if button returned of r is "Open python.org" then open location "https://www.python.org/downloads/macos/"
OSA
exit 1
